        && incoming().id == existing().id
        && incoming().user_id == existing().user_id
        && incoming().created_at == existing().created_at
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title',
          'subject',
          'messages',
          'updated_at'
        ]);
      allow delete: if isValidId(convId) && isEligibleUser() && existing().user_id == request.auth.uid;
    }

    match /circle_invites/{inviteCode} {
      allow get: if isValidId(inviteCode) && isEligibleUser();
      allow list: if false;
      allow create: if isValidId(inviteCode) && isEligibleUser() && isValidCircleInvite(incoming(), inviteCode);
      allow update: if false;
      allow delete: if isValidId(inviteCode) && isEligibleUser() && existing().owner_id == request.auth.uid;
    }

    match /circles/{circleId} {
      allow get: if isValidId(circleId) && isEligibleUser() && (
        resource == null || existing().owner_id == request.auth.uid || request.auth.uid in existing().member_uids
      );
      allow list: if isEligibleUser() && request.auth.uid in existing().member_uids;
      allow create: if isValidId(circleId)
        && isEligibleUser()
        && isValidCircleTeam(incoming(), circleId)
        && incoming().owner_id == request.auth.uid
        && request.auth.uid in incoming().member_uids
        && incoming().member_uids.size() == 1;
      allow update: if isValidId(circleId)
        && isEligibleUser()
        && isValidCircleTeam(incoming(), circleId)
        && incoming().id == existing().id
        && incoming().owner_id == existing().owner_id
        && incoming().invite_code == existing().invite_code
        && incoming().created_at == existing().created_at
        && (
          (
            existing().owner_id == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'subject', 'shared_goal', 'member_uids', 'updated_at'])
          ) || (
            !(request.auth.uid in existing().member_uids)
            && request.auth.uid in incoming().member_uids
            && incoming().member_uids.hasAll(existing().member_uids)
            && incoming().member_uids.size() == existing().member_uids.size() + 1
            && incoming().diff(existing()).affectedKeys().hasOnly(['member_uids', 'updated_at'])
          ) || (
            request.auth.uid in existing().member_uids
            && !(request.auth.uid in incoming().member_uids)
            && request.auth.uid != existing().owner_id
            && existing().member_uids.hasAll(incoming().member_uids)
            && incoming().member_uids.size() == existing().member_uids.size() - 1
            && incoming().diff(existing()).affectedKeys().hasOnly(['member_uids', 'updated_at'])
          )
        );
      allow delete: if isValidId(circleId) && isEligibleUser() && existing().owner_id == request.auth.uid;

      match /members/{memberUid} {
        allow get: if isValidId(circleId) && isValidId(memberUid) && isEligibleUser() && (
          memberUid == request.auth.uid || isCircleMember(circleId) || isCircleOwner(circleId)
        );
        allow list: if isEligibleUser() && isCircleMember(circleId);
        allow create: if isValidId(circleId)
          && isValidId(memberUid)
          && isEligibleUser()
          && memberUid == request.auth.uid
          && isValidCircleMember(incoming(), circleId, memberUid)
          && exists(/databases/$(database)/documents/circles/$(circleId))
          && (
            (incoming().role == 'owner' && get(/databases/$(database)/documents/circles/$(circleId)).data.owner_id == request.auth.uid) ||
            (incoming().role == 'member' && request.auth.uid in get(/databases/$(database)/documents/circles/$(circleId)).data.member_uids)
          );
        allow update: if isValidId(circleId)
          && isValidId(memberUid)
          && isEligibleUser()
          && memberUid == request.auth.uid
          && isCircleMember(circleId)
          && isValidCircleMember(incoming(), circleId, memberUid)
          && incoming().uid == existing().uid
          && incoming().circle_id == existing().circle_id
          && incoming().role == existing().role
          && incoming().joined_at == existing().joined_at
          && incoming().diff(existing()).affectedKeys().hasOnly(['display_name', 'show_progress', 'xp_snapshot', 'level_snapshot']);
        allow delete: if isValidId(circleId) && isValidId(memberUid) && isEligibleUser() && (
          (memberUid == request.auth.uid && existing().role != 'owner') || isCircleOwner(circleId)
        );
      }

      match /posts/{postId} {
        allow get: if isValidId(circleId) && isValidId(postId) && isEligibleUser() && isCircleMember(circleId);
        allow list: if isEligibleUser() && isCircleMember(circleId);
        allow create: if isValidId(circleId)
          && isValidId(postId)
          && isEligibleUser()
          && isValidCirclePost(incoming(), circleId, postId)
          && incoming().author_id == request.auth.uid
          && isCircleMember(circleId);
        allow update: if isValidId(circleId)
          && isValidId(postId)
          && isEligibleUser()
          && isCircleMember(circleId)
          && isValidCirclePost(incoming(), circleId, postId)
          && incoming().id == existing().id
          && incoming().circle_id == existing().circle_id
          && incoming().author_id == existing().author_id
          && incoming().created_at == existing().created_at
          && (
            (
              existing().author_id == request.auth.uid
              && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'body', 'resource_url', 'assignee_name', 'status', 'helpful_uids'])
            ) || (
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'helpful_uids'])
            )
          );
        allow delete: if isValidId(circleId) && isValidId(postId) && isEligibleUser() && (
          existing().author_id == request.auth.uid || isCircleOwner(circleId) || isAdmin()
        );
      }
    }

    match /moderation_reports/{reportId} {
      allow get: if isValidId(reportId) && isEligibleUser() && (
        resource == null || existing().reporter_id == request.auth.uid || isStaff()
      );
      allow list: if isEligibleUser() && (
        existing().reporter_id == request.auth.uid || isStaff()
      );
      allow create: if isValidId(reportId)
        && isEligibleUser()
        && isValidModerationReport(incoming(), reportId)
        && incoming().reporter_id == request.auth.uid
        && incoming().status in ['submitted', 'pending'];
      allow update: if isValidId(reportId)
        && isStaff()
        && isValidModerationReport(incoming(), reportId)
        && incoming().id == existing().id
        && incoming().reporter_id == existing().reporter_id
        && incoming().created_at == existing().created_at
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'details', 'moderator_notes', 'updated_at']);
      allow delete: if isValidId(reportId) && isAdmin();
    }

    match /help_articles/{articleId} {
      allow get: if isValidId(articleId) && (resource == null || existing().published == true || canManageHelp());
      allow list: if existing().published == true || canManageHelp();
      allow create: if isValidId(articleId) && canManageHelp() && isValidHelpArticle(incoming(), articleId);
      allow update: if isValidId(articleId)
        && canManageHelp()
        && isValidHelpArticle(incoming(), articleId)
        && incoming().id == existing().id
        && incoming().created_at == existing().created_at
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'slug',
          'title',
          'category',
          'excerpt',
          'content',
          'steps',
          'tags',
          'related_article_ids',
          'published',
          'last_updated_at',
          'author_name'
        ]);
      allow delete: if isValidId(articleId) && canManageHelp();
    }

    match /support_tickets/{ticketId} {
      allow get: if isValidId(ticketId) && isEligibleUser() && (
        resource == null || existing().user_id == request.auth.uid || isStaff()
      );
      allow list: if isEligibleUser() && (
        existing().user_id == request.auth.uid || isStaff()
      );
      allow create: if isValidId(ticketId)
        && isEligibleUser()
        && isValidSupportTicket(incoming(), ticketId)
        && incoming().user_id == request.auth.uid
        && incoming().status == 'open';
      allow update: if isValidId(ticketId)
        && isEligibleUser()
        && isValidSupportTicket(incoming(), ticketId)
        && incoming().id == existing().id
        && incoming().user_id == existing().user_id
        && incoming().created_at == existing().created_at
        && (
          (
            existing().user_id == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['messages', 'status', 'updated_at'])
            && incoming().status in ['open', 'in_progress', 'waiting_user']
          ) || (
            isStaff()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'messages',
              'status',
              'priority',
              'assigned_staff_id',
              'assigned_staff_name',
              'resolution_notes',
              'updated_at'
            ])
          )
        );
      allow delete: if isValidId(ticketId) && isAdmin();
    }

    match /technical_reports/{reportId} {
      allow get: if isValidId(reportId) && isEligibleUser() && (
        resource == null || existing().user_id == request.auth.uid || isStaff()
      );
      allow list: if isEligibleUser() && (
        existing().user_id == request.auth.uid || isStaff()
      );
      allow create: if isValidId(reportId)
        && isEligibleUser()
        && isValidTechnicalReport(incoming(), reportId)
        && incoming().user_id == request.auth.uid
        && incoming().status == 'open';
      allow update: if isValidId(reportId)
        && isStaff()
        && isValidTechnicalReport(incoming(), reportId)
        && incoming().id == existing().id
        && incoming().user_id == existing().user_id
        && incoming().created_at == existing().created_at
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updated_at']);
      allow delete: if isValidId(reportId) && isAdmin();
    }

    match /feedback_items/{feedbackId} {
      allow get: if isValidId(feedbackId) && isEligibleUser();
      allow list: if isEligibleUser();
      allow create: if isValidId(feedbackId)
        && isEligibleUser()
        && isValidFeedbackItem(incoming(), feedbackId)
        && incoming().user_id == request.auth.uid
        && incoming().status == 'submitted';
      allow update: if isValidId(feedbackId)
        && isEligibleUser()
        && isValidFeedbackItem(incoming(), feedbackId)
        && incoming().id == existing().id
        && incoming().user_id == existing().user_id
        && incoming().created_at == existing().created_at
        && (
          (
            isStaff()
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'upvotes', 'upvoted_by', 'updated_at'])
          ) || (
            incoming().diff(existing()).affectedKeys().hasOnly(['upvotes', 'upvoted_by', 'updated_at'])
          )
        );
      allow delete: if isValidId(feedbackId) && (
        (isEligibleUser() && existing().user_id == request.auth.uid) || isAdmin()
      );
    }

    match /community_resources/{resourceId} {
      allow get: if isValidId(resourceId) && (
        resource == null
        || existing().review_status == 'approved'
        || (isEligibleUser() && existing().owner_id == request.auth.uid)
        || isStaff()
      );
      allow list: if existing().review_status == 'approved'
        || (isEligibleUser() && existing().owner_id == request.auth.uid)
        || isStaff();
      allow create: if isValidId(resourceId)
        && isEligibleUser()
        && isValidCommunityResource(incoming(), resourceId)
        && incoming().owner_id == request.auth.uid
        && (incoming().review_status == 'pending_review' || isStaff());
      allow update: if isValidId(resourceId)
        && isEligibleUser()
        && isValidCommunityResource(incoming(), resourceId)
        && incoming().id == existing().id
        && incoming().owner_id == existing().owner_id
        && incoming().created_at == existing().created_at
        && (
          isStaff()
          || (existing().owner_id == request.auth.uid && incoming().review_status == 'pending_review')
        );
      allow delete: if isValidId(resourceId) && isAdmin();
    }

    match /teaching_guides/{guideId} {
      allow get: if isValidId(guideId) && (
        resource == null
        || existing().supervisor_approved == true
        || (isEligibleUser() && existing().owner_id == request.auth.uid)
        || isStaff()
      );
      allow list: if existing().supervisor_approved == true
        || (isEligibleUser() && existing().owner_id == request.auth.uid)
        || isStaff();
      allow create: if isValidId(guideId)
        && isEligibleUser()
        && isValidTeachingGuide(incoming(), guideId)
        && incoming().owner_id == request.auth.uid
        && (incoming().supervisor_approved == false || isStaff());
      allow update: if isValidId(guideId)
        && isEligibleUser()
        && isValidTeachingGuide(incoming(), guideId)
        && incoming().id == existing().id
        && incoming().owner_id == existing().owner_id
        && incoming().created_at == existing().created_at
        && (
          isStaff()
          || (existing().owner_id == request.auth.uid && incoming().supervisor_approved == false)
          || (existing().supervisor_approved == true && incoming().diff(existing()).affectedKeys().hasOnly(['quality_rating', 'rating_count', 'updated_at']))
        );
      allow delete: if isValidId(guideId) && isAdmin();
    }

    match /real_world_projects/{projectId} {
      allow get: if isValidId(projectId) && (
        resource == null
        || (existing().showcase_opt_in == true && existing().adult_supervised == true && existing().status == 'completed_verified')
        || (isEligibleUser() && existing().user_id == request.auth.uid)
        || isStaff()
      );
      allow list: if (existing().showcase_opt_in == true && existing().adult_supervised == true && existing().status == 'completed_verified')
        || (isEligibleUser() && existing().user_id == request.auth.uid)
        || isStaff();
      allow create: if isValidId(projectId)
        && isEligibleUser()
        && isValidRealWorldProject(incoming(), projectId)
        && incoming().user_id == request.auth.uid
        && incoming().adult_supervised == true
        && incoming().status in ['draft', 'in_progress'];
      allow update: if isValidId(projectId)
        && isEligibleUser()
        && isValidRealWorldProject(incoming(), projectId)
        && incoming().id == existing().id
        && incoming().user_id == existing().user_id
        && incoming().created_at == existing().created_at
        && (
          isStaff()
          || (existing().user_id == request.auth.uid && incoming().adult_supervised == true)
        );
      allow delete: if isValidId(projectId) && isEligibleUser() && (
        existing().user_id == request.auth.uid || isAdmin()
      );
    }

    match /content_error_reports/{reportId} {
      allow get: if isValidId(reportId) && isEligibleUser() && (
        resource == null || existing().reporter_id == request.auth.uid || isStaff()
      );
      allow list: if isEligibleUser() && (
        existing().reporter_id == request.auth.uid || isStaff()
      );
      allow create: if isValidId(reportId)
        && isEligibleUser()
        && isValidContentErrorReport(incoming(), reportId)
        && incoming().reporter_id == request.auth.uid
        && incoming().status == 'open';
      allow update: if isValidId(reportId)
        && isStaff()
        && isValidContentErrorReport(incoming(), reportId)
        && incoming().id == existing().id
        && incoming().reporter_id == existing().reporter_id
        && incoming().reported_at == existing().reported_at
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'resolution_note']);
      allow delete: if isValidId(reportId) && isAdmin();
    }

    match /smart_study_plans/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if isEligibleUser() && existing().user_id == request.auth.uid;
      allow create: if isValidId(userId) && isOwner(userId) && isValidSmartStudyPlan(incoming(), userId);
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidSmartStudyPlan(incoming(), userId)
        && incoming().user_id == existing().user_id;
      allow delete: if isValidId(userId) && isOwner(userId);
    }

    match /exam_questions/{questionId} {
      allow get: if isValidId(questionId) && isEligibleUser();
      allow list: if isEligibleUser();
      allow create: if isValidId(questionId) && isEligibleUser() && isValidExamQuestion(incoming(), questionId);
      allow update: if isValidId(questionId) && isStaff() && isValidExamQuestion(incoming(), questionId);
      allow delete: if isValidId(questionId) && isStaff();
    }
  }
}
