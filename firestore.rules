rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Reusable Hardened Primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isEligibleUser() {
      return isSignedIn() && (
        request.auth.token.firebase.sign_in_provider == 'google.com' ||
        request.auth.token.firebase.sign_in_provider == 'anonymous' ||
        request.auth.token.firebase.sign_in_provider == 'phone' ||
        request.auth.token.email_verified == true
      );
    }

    function isOwner(userId) {
      return isEligibleUser() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isEligibleUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email_verified == true && request.auth.token.email == 'alshbrawe7373@gmail.com')
      );
    }

    function hasStaffRole(allowedRoles) {
      return isEligibleUser()
        && exists(/databases/$(database)/documents/staff_roles/$(request.auth.uid))
        && get(/databases/$(database)/documents/staff_roles/$(request.auth.uid)).data.role in allowedRoles;
    }

    function isStaff() {
      return isAdmin() || hasStaffRole(['founder', 'admin', 'support', 'moderator', 'content_manager']);
    }

    function canManageHelp() {
      return isAdmin() || hasStaffRole(['founder', 'admin', 'content_manager']);
    }

    function isCircleMember(circleId) {
      return isEligibleUser()
        && exists(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid));
    }

    function isCircleOwner(circleId) {
      return isEligibleUser()
        && exists(/databases/$(database)/documents/circles/$(circleId))
        && get(/databases/$(database)/documents/circles/$(circleId)).data.owner_id == request.auth.uid;
    }

    function isOptionalString(data, field, maxLen) {
      return !(field in data) || data[field] == null || (data[field] is string && data[field].size() <= maxLen);
    }

    function isOptionalBool(data, field) {
      return !(field in data) || data[field] is bool;
    }

    function isOptionalNumberRange(data, field, minVal, maxVal) {
      return !(field in data) || data[field] == null || (data[field] is number && data[field] >= minVal && data[field] <= maxVal);
    }

    function isOptionalEnum(data, field, allowed) {
      return !(field in data) || data[field] == null || data[field] in allowed;
    }

    function isOptionalList(data, field, maxItems) {
      return !(field in data) || data[field] == null || (data[field] is list && data[field].size() <= maxItems);
    }

    function isBoundedStringList(data, field, maxItems) {
      return !(field in data) || (
        data[field] is list
        && data[field].size() <= maxItems
        && (data[field].size() == 0 || data[field][0] is string)
      );
    }

    // 3. Entity Validation Blueprints
    function isValidProfile(data, userId) {
      return data.keys().hasAll([
          'id',
          'display_name',
          'language',
          'region',
          'onboarded',
          'parental_consent',
          'is_anonymous'
        ])
        && data.keys().hasOnly([
          'id',
          'display_name',
          'avatar_url',
          'language',
          'region',
          'date_of_birth',
          'age_band',
          'grade_level',
          'school_name',
          'preferred_subjects',
          'learning_goals',
          'parental_consent',
          'onboarded',
          'is_anonymous',
          'auth_provider',
          'email_verified',
          'phone_number',
          'created_at',
          'updated_at'
        ])
        && data.id == userId
        && isValidId(data.id)
        && data.display_name is string
        && data.display_name.size() >= 1
        && data.display_name.size() <= 60
        && data.language in ['en', 'ar', 'ja', 'fr', 'de', 'zh-CN', 'ko']
        && data.region in ['kuwait', 'gcc', 'global']
        && data.onboarded is bool
        && data.parental_consent is bool
        && data.is_anonymous is bool
        && isOptionalString(data, 'avatar_url', 512)
        && isOptionalString(data, 'date_of_birth', 20)
        && isOptionalString(data, 'age_band', 20)
        && isOptionalString(data, 'grade_level', 60)
        && isOptionalString(data, 'school_name', 120)
        && isBoundedStringList(data, 'preferred_subjects', 12)
        && isOptionalString(data, 'learning_goals', 300)
        && isOptionalString(data, 'auth_provider', 64)
        && isOptionalBool(data, 'email_verified')
        && isOptionalString(data, 'phone_number', 32)
        && isOptionalString(data, 'created_at', 40)
        && isOptionalString(data, 'updated_at', 40);
    }

    function isValidUserSettingsKeys(data) {
      return data.keys().hasAll([
          'user_id',
          'theme',
          'font_scale',
          'dyslexia_font',
          'high_contrast',
          'reduced_motion',
          'ai_share_profile',
          'ai_share_tasks',
          'ai_share_growth',
          'notify_reminders',
          'notify_community'
        ])
        && data.keys().hasOnly([
          'user_id',
          'theme',
          'font_scale',
          'dyslexia_font',
          'high_contrast',
          'reduced_motion',
          'focus_ring',
          'simplified_ui',
          'clear_language',
          'read_aloud',
          'read_aloud_rate',
          'voice_input',
          'captions_preferred',
          'accent_color',
          'custom_accent_hex',
          'density',
          'corner_style',
          'font_family',
          'reduce_visual_effects',
          'reading_layout',
          'default_home_tab',
          'dashboard_hidden_widgets',
          'dashboard_widget_order',
          'ui_theme',
          'card_style',
          'border_style',
          'shadow_level',
          'animation_level',
          'bg_style',
          'heading_scale',
          'line_height',
          'letter_spacing',
          'font_weight',
          'readability_preset',
          'layout_workspace',
          'sidebar_mode',
          'show_quick_actions',
          'timezone',
          'date_format',
          'time_format',
          'first_day_of_week',
          'calendar_type',
          'measurement_units',
          'opportunity_scope',
          'study_explanation_lang',
          'study_complexity',
          'study_detail_level',
          'study_step_by_step',
          'study_examples_first',
          'study_visual_aids',
          'study_practice_questions',
          'study_flashcard_style',
          'study_quiz_difficulty',
          'study_session_minutes',
          'study_break_minutes',
          'study_revision_reminders',
          'ai_response_lang',
          'ai_response_length',
          'ai_tone',
          'ai_clarifying_questions',
          'ai_share_profile',
          'ai_share_tasks',
          'ai_share_growth',
          'ai_remember_preferences',
          'ai_save_history',
          'ai_proactive_suggestions',
          'ai_notifications',
          'notify_reminders',
          'notify_tasks',
          'notify_calendar',
          'notify_streak',
          'notify_opportunities',
          'notify_community',
          'notify_teams',
          'notify_email_enabled',
          'notify_push_enabled',
          'notify_frequency',
          'quiet_hours_enabled',
          'quiet_hours_start',
          'quiet_hours_end',
          'keep_signed_in',
          'profile_visibility',
          'show_in_circle',
          'ui_mode',
          'theme_preset_id',
          'layout_mode',
          'updated_at'
        ]);
    }

    function isValidUserSettingsCore(data, userId) {
      return data.user_id == userId
        && isValidId(data.user_id)
        && data.theme in ['dark', 'light', 'system']
        && data.font_scale is number && data.font_scale >= 0.8 && data.font_scale <= 1.6
        && data.dyslexia_font is bool
        && data.high_contrast is bool
        && data.reduced_motion is bool
        && isOptionalBool(data, 'focus_ring')
        && isOptionalBool(data, 'simplified_ui')
        && isOptionalBool(data, 'clear_language')
        && isOptionalBool(data, 'read_aloud')
        && isOptionalNumberRange(data, 'read_aloud_rate', 0.5, 2.0)
        && isOptionalBool(data, 'voice_input')
        && isOptionalBool(data, 'captions_preferred')
        && isOptionalString(data, 'updated_at', 40);
    }

    function isValidUserSettingsAppearance(data) {
      return isOptionalEnum(data, 'accent_color', ['teal', 'indigo', 'emerald', 'amber', 'rose', 'custom'])
        && isOptionalString(data, 'custom_accent_hex', 16)
        && isOptionalEnum(data, 'density', ['compact', 'comfortable', 'spacious'])
        && isOptionalEnum(data, 'corner_style', ['sharp', 'rounded', 'soft'])
        && isOptionalEnum(data, 'font_family', ['nexora', 'humanist', 'compact', 'serif', 'arabic', 'cjk', 'accessible'])
        && isOptionalBool(data, 'reduce_visual_effects')
        && isOptionalEnum(data, 'reading_layout', ['standard', 'focused'])
        && isOptionalEnum(data, 'default_home_tab', ['dashboard', 'growthmap', 'history', 'journal', 'overview'])
        && isOptionalList(data, 'dashboard_hidden_widgets', 10)
        && isOptionalList(data, 'dashboard_widget_order', 10)
        && isOptionalEnum(data, 'ui_theme', ['classic', 'minimal', 'focus', 'creative', 'aurora_glass', 'aurora', 'soft_modern', 'creative_neon', 'nordic_frost', 'sepia_study', 'cyber_matrix', 'midnight_purple'])
        && isOptionalEnum(data, 'card_style', ['elevated', 'flat', 'glass'])
        && isOptionalEnum(data, 'border_style', ['subtle', 'crisp', 'minimal'])
        && isOptionalEnum(data, 'shadow_level', ['none', 'soft', 'rich'])
        && isOptionalEnum(data, 'animation_level', ['full', 'subtle', 'none'])
        && isOptionalEnum(data, 'bg_style', ['ambient', 'solid', 'grid']);
    }

    function isValidUserSettingsTypographyLayout(data) {
      return isOptionalNumberRange(data, 'heading_scale', 0.85, 1.35)
        && isOptionalNumberRange(data, 'line_height', 1.25, 2.1)
        && isOptionalNumberRange(data, 'letter_spacing', -0.03, 0.08)
        && isOptionalEnum(data, 'font_weight', ['regular', 'medium'])
        && isOptionalEnum(data, 'readability_preset', ['standard', 'comfortable', 'large', 'compact', 'accessibility', 'custom'])
        && isOptionalEnum(data, 'layout_workspace', ['balanced', 'study', 'productivity', 'minimal'])
        && isOptionalEnum(data, 'sidebar_mode', ['expanded', 'compact', 'simplified'])
        && isOptionalBool(data, 'show_quick_actions')
        && isOptionalEnum(data, 'ui_mode', ['simplified', 'advanced'])
        && isOptionalString(data, 'theme_preset_id', 64)
        && isOptionalEnum(data, 'layout_mode', ['classic', 'compact', 'floating', 'right_rail', 'dual_rail', 'mini_drawer', 'top_nav', 'double_header', 'breadcrumb_bar', 'command_dock', 'zen_focus', 'split_study', 'cinema_wide', 'flashcard_stage', 'exam_proctor', 'bento', 'masonry_flow', 'kanban_columns', 'executive_kpi', 'compact_dense', 'bottom_dock', 'thumb_zone', 'prime_academy', 'scholar_codex']);
    }

    function isValidUserSettingsStudyLocale(data) {
      return isOptionalString(data, 'timezone', 64)
        && isOptionalEnum(data, 'date_format', ['auto', 'dmy', 'mdy', 'ymd'])
        && isOptionalEnum(data, 'time_format', ['12h', '24h'])
        && isOptionalEnum(data, 'first_day_of_week', ['sunday', 'monday', 'saturday'])
        && isOptionalEnum(data, 'calendar_type', ['gregorian', 'hijri'])
        && isOptionalEnum(data, 'measurement_units', ['metric', 'imperial'])
        && isOptionalEnum(data, 'opportunity_scope', ['local', 'gcc', 'global'])
        && isOptionalEnum(data, 'study_explanation_lang', ['ui', 'en', 'ar', 'ja', 'fr', 'de', 'zh-CN', 'ko'])
        && isOptionalEnum(data, 'study_complexity', ['simple', 'balanced', 'advanced'])
        && isOptionalEnum(data, 'study_detail_level', ['concise', 'standard', 'detailed'])
        && isOptionalBool(data, 'study_step_by_step')
        && isOptionalBool(data, 'study_examples_first')
        && isOptionalBool(data, 'study_visual_aids')
        && isOptionalBool(data, 'study_practice_questions')
        && isOptionalEnum(data, 'study_flashcard_style', ['recall', 'spaced', 'cloze'])
        && isOptionalEnum(data, 'study_quiz_difficulty', ['adaptive', 'foundation', 'challenge'])
        && isOptionalNumberRange(data, 'study_session_minutes', 5, 180)
        && isOptionalNumberRange(data, 'study_break_minutes', 1, 60)
        && isOptionalBool(data, 'study_revision_reminders');
    }

    function isValidUserSettingsAiPrivacy(data) {
      return isOptionalEnum(data, 'ai_response_lang', ['ui', 'en', 'ar', 'ja', 'fr', 'de', 'zh-CN', 'ko'])
        && isOptionalEnum(data, 'ai_response_length', ['concise', 'standard', 'detailed'])
        && isOptionalEnum(data, 'ai_tone', ['coach', 'calm', 'academic'])
        && isOptionalBool(data, 'ai_clarifying_questions')
        && data.ai_share_profile is bool
        && data.ai_share_tasks is bool
        && data.ai_share_growth is bool
        && isOptionalBool(data, 'ai_remember_preferences')
        && isOptionalBool(data, 'ai_save_history')
        && isOptionalBool(data, 'ai_proactive_suggestions')
        && isOptionalBool(data, 'ai_notifications')
        && data.notify_reminders is bool
        && isOptionalBool(data, 'notify_tasks')
        && isOptionalBool(data, 'notify_calendar')
        && isOptionalBool(data, 'notify_streak')
        && isOptionalBool(data, 'notify_opportunities')
        && data.notify_community is bool
        && isOptionalBool(data, 'notify_teams')
        && isOptionalBool(data, 'notify_email_enabled')
        && isOptionalBool(data, 'notify_push_enabled')
        && isOptionalEnum(data, 'notify_frequency', ['instant', 'daily', 'weekly'])
        && isOptionalBool(data, 'quiet_hours_enabled')
        && isOptionalString(data, 'quiet_hours_start', 10)
        && isOptionalString(data, 'quiet_hours_end', 10)
        && isOptionalBool(data, 'keep_signed_in')
        && isOptionalEnum(data, 'profile_visibility', ['private', 'team'])
        && isOptionalBool(data, 'show_in_circle');
    }

    function isValidUserSettings(data, userId) {
      return isValidUserSettingsKeys(data)
        && isValidUserSettingsCore(data, userId)
        && isValidUserSettingsAppearance(data)
        && isValidUserSettingsTypographyLayout(data)
        && isValidUserSettingsStudyLocale(data)
        && isValidUserSettingsAiPrivacy(data);
    }

    function isValidUserStats(data, userId) {
      return data.keys().hasAll(['user_id', 'xp', 'level', 'current_streak', 'longest_streak'])
        && data.keys().hasOnly(['user_id', 'xp', 'level', 'current_streak', 'longest_streak', 'last_active_date', 'updated_at'])
        && data.user_id == userId
        && isValidId(data.user_id)
        && data.xp is number && data.xp >= 0 && data.xp <= 1000000
        && data.level is number && data.level >= 1 && data.level <= 200
        && data.current_streak is number && data.current_streak >= 0 && data.current_streak <= 5000
        && data.longest_streak is number && data.longest_streak >= 0 && data.longest_streak <= 5000
        && isOptionalString(data, 'last_active_date', 20)
        && isOptionalString(data, 'updated_at', 40);
    }

    function isValidTask(data, taskId) {
      return data.keys().hasAll(['id', 'user_id', 'title', 'priority', 'status', 'created_at'])
        && data.keys().hasOnly([
          'id',
          'user_id',
          'title',
          'details',
          'priority',
          'status',
          'area',
          'subject',
          'recurrence',
          'subtasks',
          'due_at',
          'goal_id',
          'completed_at',
          'created_at'
        ])
        && data.id == taskId
        && isValidId(data.id)
        && data.user_id == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && isOptionalString(data, 'details', 2000)
        && data.priority in ['low', 'medium', 'high']
        && data.status in ['todo', 'in_progress', 'done', 'cancelled']
        && isOptionalEnum(data, 'area', ['academic', 'productivity', 'growth', 'wellbeing', 'career', 'community'])
        && isOptionalString(data, 'subject', 60)
        && isOptionalEnum(data, 'recurrence', ['none', 'daily', 'weekly'])
        && isOptionalList(data, 'subtasks', 15)
        && isOptionalString(data, 'due_at', 40)
        && isOptionalString(data, 'goal_id', 128)
        && isOptionalString(data, 'completed_at', 40)
        && data.created_at is string && data.created_at.size() <= 40;
    }

    function isValidGoal(data, goalId) {
      return data.keys().hasAll(['id', 'user_id', 'title', 'area', 'status', 'created_at'])
        && data.keys().hasOnly([
          'id',
          'user_id',
          'title',
          'area',
          'status',
          'is_daily',
          'last_reset_date',
          'target_date',
          'milestones',
          'completed_at',
          'created_at'
        ])
        && data.id == goalId
        && isValidId(data.id)
        && data.user_id == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.area in ['academic', 'productivity', 'growth', 'wellbeing', 'career', 'community']
        && data.status in ['active', 'paused', 'completed']
        && isOptionalBool(data, 'is_daily')
        && isOptionalString(data, 'last_reset_date', 20)
        && isOptionalString(data, 'target_date', 40)
        && isOptionalList(data, 'milestones', 12)
        && isOptionalString(data, 'completed_at', 40)
        && data.created_at is string && data.created_at.size() <= 40;
    }

    function isValidActivityEvent(data, eventId) {
      return data.keys().hasAll(['id', 'user_id', 'event_type', 'area', 'xp', 'created_at'])
        && data.keys().hasOnly(['id', 'user_id', 'event_type', 'area', 'xp', 'ref_id', 'created_at'])
        && data.id == eventId
        && isValidId(data.id)
        && data.user_id == request.auth.uid
        && data.event_type is string && data.event_type.size() >= 1 && data.event_type.size() <= 64
        && data.area in ['academic', 'productivity', 'growth', 'wellbeing', 'career', 'community']
        && data.xp is number && data.xp >= 0 && data.xp <= 100
        && isOptionalString(data, 'ref_id', 128)
        && data.created_at is string && data.created_at.size() <= 40;
    }

    function isValidStudyItem(data, itemId) {
      return data.keys().hasAll(['id', 'user_id', 'kind', 'subject', 'title', 'content', 'created_at', 'updated_at'])
        && data.keys().hasOnly([
          'id',
          'user_id',
          'kind',
          'subject',
          'topic',
          'deck',
          'title',
          'content',
          'simplified_content',
          'answer',
          'difficulty',
          'study_status',
          'mistake_reason',
          'mistake_status',
          'review_count',
          'next_review_at',
          'created_at',
          'updated_at'
        ])
        && data.id == itemId
        && isValidId(data.id)
        && data.user_id == request.auth.uid
        && data.kind in ['note', 'flashcard', 'mistake']
        && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 60
        && isOptionalString(data, 'topic', 80)
        && isOptionalString(data, 'deck', 60)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.content is string && data.content.size() <= 4000
        && isOptionalString(data, 'simplified_content', 4000)
        && isOptionalString(data, 'answer', 2000)
        && isOptionalEnum(data, 'difficulty', ['easy', 'medium', 'hard'])
        && isOptionalEnum(data, 'study_status', ['not_started', 'learning', 'needs_review', 'practicing', 'comfortable', 'completed'])
        && isOptionalString(data, 'mistake_reason', 500)
        && isOptionalEnum(data, 'mistake_status', ['open', 'reviewed', 'mastered', 'recorded', 'understanding_needed', 'explanation_viewed', 'practice_pending', 'review_scheduled', 'comfortable'])
        && isOptionalNumberRange(data, 'review_count', 0, 10000)
        && isOptionalString(data, 'next_review_at', 40)
        && data.created_at is string && data.created_at.size() <= 40
        && data.updated_at is string && data.updated_at.size() <= 40;
    }

    function isValidQuizAttempt(data, attemptId) {
      return data.keys().hasAll(['id', 'user_id', 'subject', 'total_questions', 'correct_count', 'score_pct', 'created_at'])
        && data.keys().hasOnly(['id', 'user_id', 'subject', 'total_questions', 'correct_count', 'score_pct', 'wrong_item_ids', 'created_at'])
        && data.id == attemptId
        && isValidId(data.id)
        && data.user_id == request.auth.uid
        && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 60
        && data.total_questions is number && data.total_questions >= 1 && data.total_questions <= 100
        && data.correct_count is number && data.correct_count >= 0 && data.correct_count <= 100
        && data.score_pct is number && data.score_pct >= 0 && data.score_pct <= 100
        && isOptionalList(data, 'wrong_item_ids', 50)
        && data.created_at is string && data.created_at.size() <= 40;
    }

    function isValidFocusSession(data, sessionId) {
      return data.keys().hasAll(['id', 'user_id', 'title', 'area', 'duration_minutes', 'completed', 'created_at'])
        && data.keys().hasOnly(['id', 'user_id', 'title', 'area', 'subject', 'duration_minutes', 'completed', 'created_at'])
        && data.id == sessionId
        && isValidId(data.id)
        && data.user_id == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.area in ['academic', 'productivity', 'growth', 'wellbeing', 'career', 'community']
        && isOptionalString(data, 'subject', 60)
        && data.duration_minutes is number && data.duration_minutes >= 1 && data.duration_minutes <= 180
        && data.completed is bool
        && data.created_at is string && data.created_at.size() <= 40;
    }

    function isValidCareEntry(data, entryId) {
      return data.keys().hasAll(['id', 'user_id', 'mood', 'energy', 'stress_level', 'created_at'])
        && data.keys().hasOnly(['id', 'user_id', 'mood', 'energy', 'stress_level', 'sleep_hours', 'prompt', 'note', 'created_at'])
        && data.id == entryId
        && isValidId(data.id)
        && data.user_id == request.auth.uid
        && data.mood in ['calm', 'okay', 'tired', 'stressed', 'overwhelmed', 'focused']
        && data.energy is number && data.energy >= 1 && data.energy <= 5
        && data.stress_level is number && data.stress_level >= 1 && data.stress_level <= 5
        && isOptionalNumberRange(data, 'sleep_hours', 0, 24)
        && isOptionalString(data, 'prompt', 200)
        && isOptionalString(data, 'note', 2000)
        && data.created_at is string && data.created_at.size() <= 40;
    }

    function isValidJournalEntry(data, entryId) {
      return data.keys().hasAll([
          'id',
          'user_id',
          'entry_date',
          'title',
          'reflection',
          'area',
          'mood',
          'created_at',
          'updated_at'
        ])
        && data.keys().hasOnly([
          'id',
          'user_id',
          'entry_date',
          'title',
          'reflection',
          'key_win',
          'next_step',
          'subject',
          'area',
          'mood',
          'study_minutes',
          'tags',
          'blocker',
          'gratitude',
          'created_at',
          'updated_at'
        ])
        && data.id == entryId
        && isValidId(data.id)
        && data.user_id == request.auth.uid
        && data.entry_date is string && data.entry_date.size() >= 10 && data.entry_date.size() <= 20
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.reflection is string && data.reflection.size() >= 1 && data.reflection.size() <= 4000
        && isOptionalString(data, 'key_win', 300)
        && isOptionalString(data, 'next_step', 300)
        && isOptionalString(data, 'subject', 60)
