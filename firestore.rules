        && isBoundedStringList(data, 'extension_challenges', 15)
        && data.printable_worksheet_outline is string && data.printable_worksheet_outline.size() >= 5 && data.printable_worksheet_outline.size() <= 4000
        && (!('multi_angle_explanations' in data) || data.multi_angle_explanations == null || data.multi_angle_explanations is map)
        && data.author is string && data.author.size() >= 1 && data.author.size() <= 120
        && data.version is number && data.version >= 1 && data.version <= 100
        && (!('quality_rating' in data) || data.quality_rating == null || data.quality_rating is map)
        && isOptionalNumberRange(data, 'rating_count', 0, 100000)
        && data.supervisor_approved is bool
        && isOptionalString(data, 'safety_notice', 400)
        && data.created_at is string && data.created_at.size() <= 40
        && data.updated_at is string && data.updated_at.size() <= 40;
    }

    function isValidRealWorldProject(data, projectId) {
      return data.keys().hasAll([
          'id',
          'user_id',
          'category',
          'title',
          'problem_definition',
          'intended_beneficiaries',
          'educational_purpose',
          'safe_activity_plan',
          'supervisor_name',
          'adult_supervised',
          'expected_outcomes',
          'impact_metric_value',
          'impact_metric_label',
          'showcase_opt_in',
          'status',
          'created_at',
          'updated_at'
        ])
        && data.keys().hasOnly([
          'id',
          'user_id',
          'category',
          'title',
          'problem_definition',
          'intended_beneficiaries',
          'educational_purpose',
          'safe_activity_plan',
          'required_permissions',
          'supervisor_name',
          'adult_supervised',
          'expected_outcomes',
          'evidence_summary',
          'reflection_and_lessons',
          'impact_metric_value',
          'impact_metric_label',
          'team_aliases',
          'milestones',
          'showcase_opt_in',
          'status',
          'created_at',
          'updated_at'
        ])
        && data.id == projectId
        && isValidId(data.id)
        && isValidId(data.user_id)
        && data.category in ['reading_initiative', 'educational_support', 'digital_literacy', 'environmental_awareness', 'accessibility_awareness', 'science_education', 'community_knowledge_sharing', 'responsible_tech', 'student_led_learning']
        && data.title is string && data.title.size() >= 5 && data.title.size() <= 200
        && data.problem_definition is string && data.problem_definition.size() >= 10 && data.problem_definition.size() <= 2000
        && data.intended_beneficiaries is string && data.intended_beneficiaries.size() >= 5 && data.intended_beneficiaries.size() <= 500
        && data.educational_purpose is string && data.educational_purpose.size() >= 5 && data.educational_purpose.size() <= 1000
        && data.safe_activity_plan is string && data.safe_activity_plan.size() >= 10 && data.safe_activity_plan.size() <= 2000
        && isBoundedStringList(data, 'required_permissions', 12)
        && data.supervisor_name is string && data.supervisor_name.size() >= 3 && data.supervisor_name.size() <= 120
        && data.adult_supervised is bool
        && data.expected_outcomes is string && data.expected_outcomes.size() >= 5 && data.expected_outcomes.size() <= 1000
        && isOptionalString(data, 'evidence_summary', 1500)
        && isOptionalString(data, 'reflection_and_lessons', 1500)
        && data.impact_metric_value is number && data.impact_metric_value >= 0 && data.impact_metric_value <= 1000000
        && data.impact_metric_label is string && data.impact_metric_label.size() >= 3 && data.impact_metric_label.size() <= 200
        && isBoundedStringList(data, 'team_aliases', 15)
        && isBoundedMapList(data, 'milestones', 15)
        && data.showcase_opt_in is bool
        && data.status in ['draft', 'in_progress', 'completed_verified']
        && data.created_at is string && data.created_at.size() <= 40
        && data.updated_at is string && data.updated_at.size() <= 40;
    }

    function isValidContentErrorReport(data, reportId) {
      return data.keys().hasAll([
          'id',
          'reporter_id',
          'resource_id',
          'resource_title',
          'kind',
          'details',
          'status',
          'reported_at'
        ])
        && data.keys().hasOnly([
          'id',
          'reporter_id',
          'resource_id',
          'resource_title',
          'kind',
          'details',
          'status',
          'resolution_note',
          'reported_at'
        ])
        && data.id == reportId
        && isValidId(data.id)
        && isValidId(data.reporter_id)
        && data.resource_id is string && data.resource_id.size() >= 1 && data.resource_id.size() <= 128
        && data.resource_title is string && data.resource_title.size() >= 1 && data.resource_title.size() <= 200
        && data.kind in ['factual_error', 'broken_link', 'outdated', 'copyright', 'inappropriate', 'accessibility', 'translation_issue', 'outdated_info', 'broken_source', 'accessibility_issue']
        && data.details is string && data.details.size() >= 10 && data.details.size() <= 2000
        && data.status in ['open', 'resolved']
        && isOptionalString(data, 'resolution_note', 1000)
        && data.reported_at is string && data.reported_at.size() <= 40;
    }

    function isValidSmartStudyPlan(data, userId) {
      return data.keys().hasAll([
          'user_id',
          'daily_minutes',
          'preferred_time',
          'blocked_weekdays',
          'subjects',
          'blocks',
          'updated_at'
        ])
        && data.keys().hasOnly([
          'user_id',
          'daily_minutes',
          'preferred_time',
          'commitments_note',
          'blocked_weekdays',
          'subjects',
          'blocks',
          'engine',
          'updated_at'
        ])
        && data.user_id == userId
        && isValidId(data.user_id)
        && data.daily_minutes is number && data.daily_minutes >= 15 && data.daily_minutes <= 360
        && data.preferred_time in ['morning', 'afternoon', 'evening']
        && isOptionalString(data, 'commitments_note', 300)
        && data.blocked_weekdays is list && data.blocked_weekdays.size() <= 7
        && isBoundedMapList(data, 'subjects', 16)
        && isBoundedMapList(data, 'blocks', 40)
        && isOptionalString(data, 'engine', 40)
        && data.updated_at is string && data.updated_at.size() <= 40;
    }

    function isValidExamQuestion(data, questionId) {
      return data.keys().hasAll([
          'id',
          'subject',
          'topic',
          'difficulty',
          'format',
          'prompt',
          'model_answer',
          'explanation',
          'created_at'
        ])
        && data.keys().hasOnly([
          'id',
          'subject',
          'topic',
          'difficulty',
          'format',
          'prompt',
          'options',
          'correct_index',
          'accepted_keywords',
          'model_answer',
          'explanation',
          'created_at'
        ])
        && data.id == questionId
        && isValidId(data.id)
        && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 80
        && data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 120
        && data.difficulty in ['foundation', 'standard', 'challenge']
        && data.format in ['mcq', 'true_false', 'short_answer', 'written_response']
        && data.prompt is string && data.prompt.size() >= 5 && data.prompt.size() <= 1000
        && isBoundedStringList(data, 'options', 8)
        && isOptionalNumberRange(data, 'correct_index', 0, 7)
        && isBoundedStringList(data, 'accepted_keywords', 20)
        && data.model_answer is string && data.model_answer.size() >= 1 && data.model_answer.size() <= 1000
        && data.explanation is string && data.explanation.size() >= 1 && data.explanation.size() <= 1000
        && data.created_at is string && data.created_at.size() <= 40;
    }

    // 4. Collection Rules

    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && isOwner(adminUid);
      allow list, write: if false;
    }

    match /staff_roles/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isAdmin() && isValidStaffRole(incoming(), userId);
      allow update: if isValidId(userId)
        && isAdmin()
        && isValidStaffRole(incoming(), userId)
        && incoming().user_id == existing().user_id
        && incoming().created_at == existing().created_at
        && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'email', 'assigned_by', 'updated_at']);
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /profiles/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isStaff());
      allow list: if (isEligibleUser() && existing().id == request.auth.uid) || isStaff();
      allow create: if isValidId(userId) && isOwner(userId) && isValidProfile(incoming(), userId);
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidProfile(incoming(), userId)
        && incoming().id == existing().id
        && (!('created_at' in existing()) || incoming().created_at == existing().created_at)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'display_name',
          'avatar_url',
          'language',
          'region',
          'date_of_birth',
          'age_band',
          'grade_level',
          'school_name',
          'preferred_subjects',
          'learning_goals',
          'parental_consent',
          'onboarded',
          'is_anonymous',
          'auth_provider',
          'email_verified',
          'phone_number',
          'updated_at'
        ]);
      allow delete: if isValidId(userId) && isOwner(userId);
    }

    match /user_settings/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if isEligibleUser() && existing().user_id == request.auth.uid;
